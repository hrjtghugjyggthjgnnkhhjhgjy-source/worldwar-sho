<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>چت مدرن</title>
    <style>
        /* تنظیمات کلی صفحه */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Tahoma, 'Segoe UI', sans-serif;
        }

        body {
            /* یک پس‌زمینه تیره با تصویر برای اینکه افکت شیشه‌ای دیده بشه */
            background: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.9)), 
                        url('https://images.unsplash.com/photo-1519681393784-d120267933ba?q=80&w=1000&auto=format&fit=crop') no-repeat center center/cover;
            height: 100vh;
            display: flex;
            flex-direction: column;
            color: white;
            overflow: hidden;
        }

        /* هدر بالای صفحه */
        .chat-header {
            background: rgba(20, 20, 20, 0.6);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            padding: 15px 20px;
            display: flex;
            align-items: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            z-index: 10;
        }

        .chat-header h2 {
            font-size: 16px;
            font-weight: normal;
        }

        /* بخش نمایش پیام‌ها */
        .chat-messages {
            flex-grow: 1;
            padding: 20px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        /* استایل پیام‌ها */
        .message {
            max-width: 70%;
            padding: 10px 15px;
            border-radius: 15px;
            font-size: 14px;
            line-height: 1.5;
            backdrop-filter: blur(5px);
        }

        .msg-received {
            background: rgba(50, 50, 50, 0.7);
            align-self: flex-start;
            border-bottom-right-radius: 2px;
        }

        .msg-sent {
            background: rgba(0, 120, 255, 0.7); /* رنگ آبی برای پیام‌های خودت */
            align-self: flex-end;
            border-bottom-left-radius: 2px;
        }

        /* کادر تایپ شیشه‌ای (دقیقاً مثل روبیکا) */
        .chat-input-area {
            padding: 15px;
            background: rgba(20, 20, 20, 0.4); /* پس‌زمینه نیمه‌شفاف برای کل پایین صفحه */
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }

        .chat-input-container {
            display: flex;
            align-items: center;
            background: rgba(40, 40, 40, 0.6); /* پس‌زمینه کادر تایپ */
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border-radius: 50px; /* شکل کپسولی */
            padding: 8px 15px;
            border: 1px solid rgba(255, 255, 255, 0.15); /* حاشیه ظریف */
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3); /* سایه برای برجسته شدن */
        }

        /* ورودی متن */
        .message-input {
            flex-grow: 1;
            background: transparent;
            border: none;
            color: white;
            outline: none;
            font-size: 14px;
            padding: 0 10px;
        }

        .message-input::placeholder {
            color: #a0a0a0;
        }

        /* دکمه‌ها و آیکون‌ها */
        .icon-btn {
            background: transparent;
            border: none;
            color: #b0b0b0;
            font-size: 20px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 5px;
            transition: color 0.3s;
        }

        .icon-btn:hover {
            color: white;
        }

        /* دکمه اختصاصی GIF */
        .gif-btn {
            border: 1.5px solid #b0b0b0;
            border-radius: 8px;
            font-size: 11px;
            padding: 2px 6px;
            font-weight: bold;
            margin-left: 10px;
        }
        
        .gif-btn:hover {
            border-color: white;
            color: white;
        }

        /* تغییر رنگ اسکرول‌بار */
        .chat-messages::-webkit-scrollbar {
            width: 6px;
        }
        .chat-messages::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.2);
            border-radius: 10px;
        }
    </style>
</head>
<body>

    <!-- هدر چت -->
    <div class="chat-header">
        <h2>گفتگو با رفیق</h2>
    </div>

    <!-- بخش پیام‌ها -->
    <div class="chat-messages">
        <div class="message msg-received">سلام! این یک پیام تستی است.</div>
        <div class="message msg-sent">سلام به روی ماهت! ببین کادر تایپ پایین چقدر شیک شده.</div>
        <div class="message msg-received">آره واقعاً شبیه روبیکا شد! افکت شیشه‌ایش عالیه.</div>
    </div>

    <!-- کادر تایپ شیشه‌ای -->
    <div class="chat-input-area">
        <div class="chat-input-container">
            <button class="icon-btn gif-btn">GIF</button>
            
            <input type="text" class="message-input" placeholder="پیام...">
            
            <!-- آیکون کلیپ (با ایموجی جایگزین شده) -->
            <button class="icon-btn" title="پیوست">📎</button>
            <!-- آیکون میکروفون -->
            <button class="icon-btn" title="میکروفون">🎤</button>
        </div>
    </div>

</body>
</html>
